# Port for local development
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hotel_db?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=8h

# Allowed origins for CORS (comma-separated, or * for all)
CORS_ORIGIN=*
